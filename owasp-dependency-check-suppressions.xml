<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    
    <!-- Example suppressions - customize based on your project needs -->
    
    <!-- Suppress false positives for Spring Boot -->
    <suppress>
        <notes><![CDATA[
        False positive for Spring Boot Actuator
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring\-boot\-starter\-actuator@.*$</packageUrl>
        <cve>CVE-2021-22118</cve>
    </suppress>
    
    <!-- Suppress false positives for test dependencies -->
    <suppress>
        <notes><![CDATA[
        Test scope dependency issues
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring\-boot\-starter\-test@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    
    <!-- Add more suppressions as needed for your specific dependencies -->
    
</suppressions>
